{
  "name": "bardy",
  "version": "0.0.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "predev": "node -e \"if(process.platform==='darwin'){const p='node_modules/electron/dist/Electron.app/Contents/Info.plist';for(const k of ['CFBundleName','CFBundleDisplayName'])require('child_process').execFileSync('plutil',['-replace',k,'-string','Bardy',p])}\"",
    "dev": "electron-vite dev",
    "dev:slow": "npm run dev -- --mode slow",
    "dev:error": "npm run dev -- --mode error",
    "test": "node --test tests/*.test.ts tests/focus-blocker.test.ts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "npm run typecheck && electron-vite build"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "lucide-react": "^1.54.0",
    "marked": "^18.1.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  }
}